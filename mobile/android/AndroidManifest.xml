<?xml version="1.0" encoding="utf-8"?>
<!-- MyLearningPlatform 안드로이드 앱(mobile/android/). 설계: docs/P4_설계서_Mobile.md 3.2절. MWL mobile/android/AndroidManifest.xml(MiddlewareLearner@e55b9c0)을 옮겨 고쳤다.
     권한은 하나도 없다 — 인터넷(INTERNET)도 없다(CLAUDE.md 13절 · NFR-401 — scripts/build_android.sh 가 빌드한 APK 를 열어 본다).
     판 번호(versionCode·versionName)·minSdk·targetSdk·디버그 표시는 scripts/build_android.sh 가 aapt2 에 넘긴다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.hipiboy7.mylearningplatform">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!-- WebView 사용 통계를 보내지 않는다 · 주소 평판을 바깥에 묻지 않는다 -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <!-- 회전·접기·펼치기(폴드5)·자판에는 화면을 다시 만들지 않는다(복습 중인 자리·적던 글이 그대로). 밝기(uiMode)가 바뀌면 새로 그린다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 공유로 교환 파일을 넘길 때만 받는 앱에 읽기 권한을 잠깐 준다 -->
        <provider
            android:name=".ShareProvider"
            android:authorities="io.github.hipiboy7.mylearningplatform.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
